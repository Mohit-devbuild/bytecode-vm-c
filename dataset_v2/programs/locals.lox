// locals.lox -- GET_LOCAL / SET_LOCAL traffic.
// Requires a global `n` (iteration count), injected by the runner.
// Metric target: stack-slot access cost (no hashing, no arithmetic in the body).

fun run(n) {
  var a = 1;
  var b = 2;
  var c = 3;
  var d = 4;
  for (var i = 0; i < n; i = i + 1) {
    a = b; b = c; c = d; d = a;
    a = b; b = c; c = d; d = a;
  }
  return a;
}

print run(n);